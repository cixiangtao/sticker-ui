{
  "$schema": "https://unpkg.com/release-it@20/schema/release-it.json",
  "git": {
    "commit": true,
    "commitMessage": "chore(release): v${version}",
    "requireBranch": "main",
    "tag": true,
    "tagName": "v${version}",
    "push": true,
    "requireCleanWorkingDir": true
  },
  "github": {
    "release": false
  },
  "hooks": {
    "before:init": "pnpm run release:check",
    "after:release": "echo Pushed ${name} v${version}; GitHub Actions will publish npm and create the GitHub Release"
  },
  "npm": {
    "publish": false
  }
}
